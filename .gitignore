# XcodeGen 生成物（以 project.yml 为准）
*.xcodeproj/
*.xcworkspace/
!*.xcodeproj/project.xcworkspace/
DerivedData/
build/
*.xcresult
xcuserdata/
.DS_Store
.swiftpm/

# Python 评测脚本运行产物
__pycache__/
*.pyc

# 真实照片 / 测试集一律不进仓库（见 docs/PLAN.md 硬规则）
testdata/
eval/data/
*.heic
*.HEIC
*.jpg
*.jpeg
*.JPG
*.png
!docs/**/*.png

# 模型权重默认不进 git，用脚本下载并校验 SHA-256（见 CONTRIBUTING.md）
*.mlmodel
*.mlpackage/
*.mlmodelc/
*.onnx
*.pt
*.pth

# 用户明确审核并要求随包发布的 UVDoc FP16 模型（来源与许可见 docs/MODELS.md）。
!LocalScan/Resources/Models/UVDocCoreML.mlpackage/
!LocalScan/Resources/Models/UVDocCoreML.mlpackage/Data/com.apple.CoreML/model.mlmodel
